---
title: News & Stories
description: News and stories from the McKenzie River Guides Association, including river hazard updates.
navKey: news
permalink: /news/
pageScript: news.js
pageCss: events.css
---
{%- set posts = collections.posts -%}
{%- set first = posts[0] -%}
<div class="page-hero compact">
  <div class="wrap">
    <div>
      <h1>News &amp; <em>Stories</em></h1>
      <p class="status">Association news, river updates and stories from the McKenzie.</p>
    </div>
    <div class="adm-slot" data-admin-new="posts" hidden></div>
    {% if collections.newsletters.length %}<a class="btn btn-ghost" href="#newsletters">Past newsletters</a>{% endif %}
  </div>
</div>

<section class="tight">
  <div class="wrap">
    {%- if collections.events.length %}
    <div class="events-top" id="events" data-events>
      <span class="eyebrow">Coming up</span>
      <h2>Association events</h2>
      <div class="adm-slot" data-admin-new="events" hidden></div>
      {% include "partials/event-cards.njk" %}
    </div>
    {%- endif %}

    {% if first -%}
    <a class="feature" href="{{ first.url }}" data-item="{{ first.inputPath | replace('./', '') }}">
      {% if first.data.cover %}<img class="cover" src="{{ first.data.cover }}" alt="" loading="eager">{% else %}<div class="ph"></div>{% endif %}
      <div>
        <time datetime="{{ first.date | isoDate }}">{{ first.date | monthYear }}</time>
        <h2>{{ first.data.title }}</h2>
        {% if first.data.summary %}<p>{{ first.data.summary }}</p>{% endif %}
        <p style="margin-top:18px"><span class="btn btn-line">Read the story</span></p>
      </div>
    </a>
    {%- endif %}


    {%- set cats = posts | uniqueCats %}
    {%- if cats.length > 1 %}
    <div class="filters" role="group" aria-label="Filter posts">
      <button class="chip" type="button" aria-pressed="true">All</button>
      {%- for c in cats %}<button class="chip" type="button" aria-pressed="false">{{ c }}</button>{% endfor %}
    </div>
    {%- endif %}

    <div class="post-grid">
      {%- for p in posts %}{% if not loop.first %}
      <a class="pcard" href="{{ p.url }}" data-item="{{ p.inputPath | replace('./', '') }}" data-cats="{{ (p.data.categories or []) | join('|') }}">{% if p.data.cover %}<img class="cover" src="{{ p.data.cover }}" alt="" loading="lazy">{% else %}<div class="ph"></div>{% endif %}{% if p.data.categories and p.data.categories.length %}<span class="cat">{{ p.data.categories[0] }}</span>{% endif %}<h3>{{ p.data.title }}</h3>{% if p.data.summary %}<p>{{ p.data.summary }}</p>{% endif %}<time datetime="{{ p.date | isoDate }}">{{ p.date | monthYear }}</time></a>
      {%- endif %}{% endfor %}
    </div>

    {% if collections.newsletters.length -%}
    <div class="newsletters" id="newsletters">
      <div>
        <span class="eyebrow">Newsletter</span>
        <h2>Past newsletters</h2>
        <p>Members get two newsletters a year by email: the season plan and annual dinner in spring, the season recap and annual meeting in fall. Every issue is kept here.</p>
      </div>
      <div class="nl-list">
        {%- set lastYear = "" -%}
        {%- for yr, issues in collections.newsletters | groupby("data.year") %}
        <h3>{{ yr }}</h3>
        <ul>{% for n in issues %}<li><a href="{{ n.url }}"><span class="nl-name">{{ n.data.title }}</span>{% if n.data.contents %}<span class="nl-what">{{ n.data.contents }}</span>{% endif %}</a></li>{% endfor %}</ul>
        {%- endfor %}
      </div>
    </div>
    {%- endif %}
  </div>
</section>
