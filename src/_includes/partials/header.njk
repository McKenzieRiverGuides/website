{#- Shared site header + phone menu. navKey marks the current page. The logo is the way home (no "Home" link).
   Leadership and Members live in the footer and on About/Join; Conservation and Drift Boat are deferred (see AGENTS.md). -#}
{%- set nav = [
  ["guides", "Find a Guide", "/find-a-guide/"],
  ["river", "River Conditions", "/river-conditions/"],
  ["news", "News", "/news/"],
  ["about", "About", "/about/"],
  ["contact", "Contact", "/contact/"]
] -%}
{%- set links -%}
{%- for n in nav -%}
<li><a href="{{ n[2] }}"{% if n[0] == navKey %} aria-current="page"{% endif %}>{{ n[1] | safe }}</a></li>
{%- endfor -%}
{%- endset -%}
{%- set joinBtn -%}<a class="btn btn-cedar" href="/join/"{% if navKey == "join" %} aria-current="page"{% endif %}>Join</a>{%- endset -%}
<a class="skip-link" href="#main">Skip to content</a>
<header class="site-head{% if darkHead %} dark{% endif %}">
  <div class="wrap head-row">
    <a class="logo" href="/">
      <img class="logo-mark" src="/images/logo/mrga-logo-badge.png" width="1620" height="796" alt="McKenzie River Guides logo, celebrating 95 years, 1931 to 2026">
      <script>/* Anniversary logo through 2026; everyday round logo from 2027 (?year=2027 previews it). */
      (function(){var y=+(new URLSearchParams(location.search).get("year"))||new Date().getFullYear();
      if(y>=2027){var i=document.currentScript.previousElementSibling;i.src="/images/logo/mrga-logo.svg";i.className="logo-mark round";i.width=i.height=1820;i.alt="McKenzie River Guides logo, organized 1931";}})();</script>
      <span class="logo-text">McKenzie River<br>Guides Association</span>
    </a>
    <ul class="nav">{{ links | safe }}<li>{{ joinBtn | safe }}</li></ul>
    <button class="menu-btn" type="button" aria-expanded="false" aria-controls="menuPanel">Menu</button>
  </div>
</header>
<nav class="menu-panel" id="menuPanel" aria-label="Site menu">
  <ul>{{ links | safe }}</ul>
  {{ joinBtn | safe }}
</nav>
