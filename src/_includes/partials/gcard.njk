{#- One Find a Guide card. Keep in step with card() in assets/js/find-a-guide.js. Never show town.
    The whole card opens the guide's own page (/guides/<slug>/); the phone link still calls directly. -#}
{%- set sp = g["Specialty"] | specs -%}
{%- set name = (g["First Name"] + " " + g["Last Name"]) | trim -%}
<article class="gcard{% if g.slug %} has-page{% endif %}"><div class="gcard-top"><span class="mono" aria-hidden="true">{{ (g["First Name"] | first) }}{{ (g["Last Name"] | first) }}</span><div><h3>{% if g.slug %}<a href="/guides/{{ g.slug }}/">{{ name }}</a>{% else %}{{ name }}{% endif %}</h3>{% if g | bizName %}<p class="biz">{{ g | bizName }}</p>{% endif %}</div></div>
{%- if g["Life Member"] | yes %}<span class="badge">Life member</span>{% endif -%}
{%- if sp.length %}<p class="specs">{{ sp | join(" · ") }}</p>{% endif -%}
<div class="gcard-links">{% set ph = g.Phone | phones %}{% if ph.length %}<span class="phones">{% for p in ph %}<a href="tel:{{ p | telHref }}">{{ p }}</a>{% endfor %}</span>{% endif %}{% if g.slug %}<span class="more" aria-hidden="true">Details →</span>{% elif g.Link %}<a href="{{ g.Link | linkHref }}" target="_blank" rel="noopener">{{ g.Link | linkHost }} ↗</a>{% endif %}</div>
</article>
