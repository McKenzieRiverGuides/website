<!doctype html>
<html lang="en">
<head>
{% include "partials/head.njk" %}
<link rel="stylesheet" href="/assets/css/inner.css?v={{ build.version }}">
{% if pageCss %}<link rel="stylesheet" href="/assets/css/{{ pageCss }}?v={{ build.version }}">{% endif %}
</head>
<body data-page="{{ navKey }}">
{% include "partials/header.njk" %}
<main id="main" tabindex="-1">
{{ content | safe }}
</main>
{% include "partials/footer.njk" %}
<script src="/assets/js/site.js?v={{ build.version }}"></script>
{% if pageScript %}<script src="/assets/js/{{ pageScript }}?v={{ build.version }}"></script>{% endif %}
</body>
</html>
