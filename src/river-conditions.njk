<div class="page-hero compact">
  <div class="wrap">
    <div>
      <h1>River <em>conditions</em></h1>
      <p class="status" id="v-updated"><span class="spin sm light" aria-hidden="true"></span>Loading live readings…</p>
    </div>
    <div class="now" aria-live="polite">
      <span class="now-where">McKenzie near Vida, now</span>
      <div class="now-vals">
        <div><b id="v-flow">—</b><span>cfs</span></div>
        <div><b id="v-temp">—</b><span>water</span></div>
        <div><b id="v-trend">—</b><span>flow, last 24 h</span></div>
      </div>
    </div>
  </div>
</div>

<section class="tight">
  <div class="wrap rc-grid">
    <div class="card">
      <span class="eyebrow">Main gauge</span>
      <h2>McKenzie near Vida</h2>
      <small class="updated">USGS gauge 14162500</small>
      <div class="small">
        <div><b id="v-height">—</b><span>Gauge height</span></div>
        <div><b id="v-turb">—</b><span>Turbidity</span></div>
        <div><b id="v-do">—</b><span>Oxygen</span></div>
        <div><b id="v-ph">—</b><span>pH</span></div>
      </div>
      <p class="note-sm">Turbidity is how cloudy the water is: lower is clearer. <a href="https://waterdata.usgs.gov/monitoring-location/14162500/" target="_blank" rel="noopener">All readings at USGS ↗</a></p>
    </div>

    <div class="card">
      <div class="chart-tools">
        <div class="seg" role="group" aria-label="Reading" id="metric">
          <button type="button" data-m="00060" aria-pressed="true">Flow</button>
          <button type="button" data-m="00010" aria-pressed="false">Water temp</button>
          <button type="button" data-m="00065" aria-pressed="false">Gauge height</button>
        </div>
        <div class="seg" role="group" aria-label="Time range" id="range">
          <button type="button" data-d="1" aria-pressed="false">24 hours</button>
          <button type="button" data-d="7" aria-pressed="true">7 days</button>
          <button type="button" data-d="30" aria-pressed="false">30 days</button>
        </div>
      </div>
      <div class="chart-head"><div class="chart-title" id="c-title">Flow near Vida, last 7 days</div>
        <div class="legend" id="legend" hidden><span><i class="sw obs"></i>Observed (USGS)</span><span><i class="sw fc"></i>NOAA forecast</span></div></div>
      <div class="chart" id="chart">
        <div class="chart-msg" id="c-msg"><div><span class="spin" aria-hidden="true"></span>Loading the last 30 days…</div></div>
        <div class="tip" id="tip"></div>
      </div>
      <div class="chart-foot">
        <span>Observed: USGS (provisional). <span id="fc-issued"></span></span>
        <a href="https://www.nwrfc.noaa.gov/river/station/flowplot/flowplot.cgi?lid=VIDO3" target="_blank" rel="noopener">NOAA flow forecast for Vida ↗</a>
      </div>
      <details class="table">
        <summary>Show as a table</summary>
        <table><thead><tr><th id="t-when">Day</th><th>Low</th><th>Average</th><th>High</th></tr></thead><tbody id="t-body"></tbody></table>
      </details>
    </div>
  </div>
</section>

<section class="alt">
